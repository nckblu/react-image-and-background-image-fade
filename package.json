{
  "name": "react-image-and-background-image-fade",
  "version": "2.0.0-alpha.0",
  "description": "A modern React image loading toolkit for images, background images, placeholders, lazy loading, and fade transitions.",
  "author": "nckblu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nckblu/react-image-and-background-image-fade.git"
  },
  "homepage": "https://react-image-and-background-image-fade.com/",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react image",
    "react image fade",
    "react background image",
    "react background image fade",
    "react image preloader",
    "react lazy image",
    "react responsive image",
    "image placeholder",
    "blur placeholder",
    "background image lazy load"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run lint:package && npm pack --dry-run",
    "clean": "rimraf dist coverage",
    "lint:package": "publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.8",
    "esbuild": "^0.28.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.59.1",
    "publint": "^0.3.20",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.8"
  }
}
